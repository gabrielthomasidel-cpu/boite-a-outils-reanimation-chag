<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lanceur Windows de Commandes Réanimation.
       .NET Framework 4.6 : présent sur toutes les versions de Windows 10/11.
       Construction : windows/construire-lanceur.sh (dotnet SDK, même sous Linux). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net46</TargetFramework>
    <AssemblyName>CommandesReanimation</AssemblyName>
    <RootNamespace>CommandesReanimation</RootNamespace>
    <ApplicationIcon>../app.ico</ApplicationIcon>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Product>Commandes Réanimation</Product>
    <Company>Gabriel THOMAS</Company>
    <AssemblyTitle>Commandes Réanimation</AssemblyTitle>
    <Version>2.7.0</Version>
    <Copyright>Gabriel THOMAS</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
