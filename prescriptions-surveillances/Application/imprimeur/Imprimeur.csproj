<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041 : necessaire pour Windows.Data.Pdf, le rendu PDF
         livre avec Windows. Aucune dependance a telecharger. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ImprimerPdf</AssemblyName>
    <RootNamespace>Prescription.Imprimeur</RootNamespace>
    <!-- WinExe sans fenetre : pas de console qui clignote a chaque impression.
         Le compte rendu part dans un fichier, pas sur la sortie standard. -->
    <NoWarn>CA1416</NoWarn>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

</Project>
